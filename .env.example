# ===== 模式开关 =====
# 1 = 离线模拟模式（默认，无需任何凭证即可跑通全流程）
# 0 = 真实飞书模式（需填下方凭证与权限）
FEISHU_MOCK=1

# ===== 飞书自建应用凭证（开发者后台 -> 应用凭证）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 运行资源（setup 命令可自动生成）=====
# 多维表格 app_token；留空时真实模式下会自动创建并回写
FEISHU_BITABLE_APP_TOKEN=
# 机器人所在群 chat_id（消息卡片发到这里）；留空则只写表格不发消息
FEISHU_CHAT_ID=

# ===== 其他 =====
FEISHU_BASE_URL=https://open.feishu.cn
STATE_DIR=state
