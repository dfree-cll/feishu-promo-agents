# ===== 模式开关 =====
# 1 = 离线模拟模式（默认，无需任何凭证即可跑通全流程）
# 0 = 真实飞书模式（需填下方凭证与权限）
FEISHU_MOCK=1

# ===== 飞书自建应用凭证（开发者后台 -> 应用凭证）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 运行资源（setup 命令可自动生成）=====
# 多维表格 app_token；留空时真实模式下会自动创建并回写
FEISHU_BITABLE_APP_TOKEN=
# 机器人所在群 chat_id（消息卡片发到这里）；为空则尝试 Webhook 自定义机器人
FEISHU_CHAT_ID=
# 自定义机器人 Webhook（群设置->群机器人->自定义机器人）；配置后无需任何 IM 权限
FEISHU_WEBHOOK_URL=

# ===== LLM（Agent 的大脑；任选一家 OpenAI 兼容服务）=====
# GLM:      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com               LLM_MODEL=deepseek-flash
# Kimi:     LLM_BASE_URL=https://api.moonshot.cn/v1             LLM_MODEL=moonshot-v1-8k
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 审批与并发 =====
# 人工审核流：1 = 申请需管理者回复同意/驳回后才生效；0 = 申请直接生效（默认）
REVIEW_ENABLED=0
# 可执行审核/回滚指令的发送者 open_id 白名单（逗号分隔）；留空 = 不校验
APPROVER_OPEN_IDS=
# 群消息并发工作线程数 / LLM 调用并发上限
LISTEN_WORKERS=8
MAX_CONCURRENT_LLM=8

# ===== 其他 =====
FEISHU_BASE_URL=https://open.feishu.cn
STATE_DIR=state
